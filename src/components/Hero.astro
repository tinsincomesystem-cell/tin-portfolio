---
import { Image } from 'astro:assets';
import { site, rich } from '../lib/content';
import { img } from '../lib/images';
const h = site.hero;
const photo = img(h.photo);
const frames = h.frames?.count > 0 ? h.frames : null;
const firstFrame = frames ? frames.pattern.replace('{n}', '1'.padStart(frames.digits || 3, '0')) : '';
---
<section id="top" class="hero s-dark grain" aria-labelledby="hero-title" data-frames={frames ? JSON.stringify(frames) : undefined}>
  <div class="hero-pin">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow hero-in">{h.eyebrow}</p>
        <h1 id="hero-title" class="h-display hero-title">
          {h.headline.map((line: string) => (
            <span class="line-mask"><span class="hero-line" set:html={rich(line)} /></span>
          ))}
        </h1>
        <p class="lead hero-in">{h.subhead}</p>
        <div class="hero-ctas hero-in">
          <a class="btn" href={site.bookingUrl} target="_blank" rel="noopener" data-magnetic data-cursor="Book">
            {site.bookingLabel} <span class="arrow" aria-hidden="true">→</span>
          </a>
          <a class="btn btn-ghost" href={h.secondaryCta.href}>{h.secondaryCta.label}</a>
        </div>
      </div>

      <div class="hero-stage" aria-label="Animated preview: Tin moving branding, website and funnel work around her">
        <canvas class="hero-net" aria-hidden="true"></canvas>
        <div class="hero-glow" aria-hidden="true"></div>
        <div class="hero-me" style={photo ? `aspect-ratio:${photo.width}/${photo.height}` : undefined}>
          {frames ? (
            <picture>
              <source media="(max-width: 639px)" srcset={`${frames.folder}m/${firstFrame}`} />
              <img class="hero-first" src={`${frames.folder}${firstFrame}`} alt={h.photoAlt} width="1060" height="1280" fetchpriority="high" />
            </picture>
          ) : photo && (
            <Image src={photo} alt={h.photoAlt} widths={[420, 640, 900]} sizes="(min-width: 1024px) 34vw, 70vw" loading="eager" fetchpriority="high" class="hero-photo" />
          )}
          {frames && <canvas class="hero-frames" aria-hidden="true"></canvas>}
        </div>
        <svg class="hero-beams" aria-hidden="true">
          <defs>
            <linearGradient id="beamGrad" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#5ee6c8" /><stop offset="1" stop-color="#c8a97e" /></linearGradient>
            <filter id="neon" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="3" result="b" /><feMerge><feMergeNode in="b" /><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge></filter>
          </defs>
          {h.mockups.map(() => <path class="beam" pathLength="1" />)}
          <path class="trail" /><circle class="touch-halo" r="16" /><circle class="touch" r="5" />
        </svg>
        {h.chat && (
          <div class="chat" aria-hidden="true">
            <p class="bub b-client"><span class="ava">👤</span><span>{h.chat.client}</span></p>
            <p class="bub b-tin"><span>{h.chat.reply}</span></p>
          </div>
        )}
        <ul class="hero-cards" role="list">
          {h.mockups.map((m: any, i: number) => {
            const thumb = img(m.image);
            return (
              <li class="hcard" style={`--i:${i}`}>
                <a class="hcard-inner" href={m.href}>
                  <span class="hcard-label mono">{m.label}</span>
                  {thumb && <Image src={thumb} alt="" widths={[240, 480]} sizes="(min-width: 1024px) 220px, 150px" class="hcard-thumb" loading="eager" />}
                  <span class="hcard-title">{m.title}</span>
                  <span class="hcard-state"><i aria-hidden="true"></i><span class="s-wait">Working…</span><span class="s-done">{m.state}</span></span>
                </a>
                <span class="tap" aria-hidden="true"></span><span class="tap tap2" aria-hidden="true"></span>
              </li>
            );
          })}
        </ul>
      </div>
    </div>

    <ul class="hero-facts wrap" role="list">
      {site.facts.map((f: any) => (
        <li class="hero-in"><strong>{f.value}</strong><span>{f.label}</span></li>
      ))}
    </ul>
  </div>
</section>

<style>
  .hero { min-height: 100svh; }
  .hero-pin { min-height: 100svh; display: flex; flex-direction: column; justify-content: flex-start; padding-top: 6.5rem; padding-bottom: 1.5rem; overflow: hidden; position: relative; z-index: 1; }
  .hero-grid { display: grid; gap: var(--space-l); align-items: center; }
  .hero-copy { display: grid; gap: var(--space-m); position: relative; z-index: 3; }
  .hero-title { font-size: clamp(3rem, 1.4rem + 5.4vw, 6.4rem); }
  .hero-title :global(em) { color: var(--champagne); }
  .hero-ctas { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: .25rem; }

  .hero-stage { position: relative; aspect-ratio: 4 / 4.4; width: 100%; max-width: 640px; margin-inline: auto; }
  .hero-net { position: absolute; inset: -10% -15%; width: 130%; height: 120%; opacity: .9; }
  .hero-glow { position: absolute; inset: 8% 14% 0; background: radial-gradient(closest-side, rgb(200 169 126 / .30), rgb(198 93 59 / .10) 55%, transparent 75%); filter: blur(10px); }
  .hero-me { position: absolute; left: 50%; bottom: 0; width: 64%; transform: translateX(-50%); z-index: 1; }
  .hero-photo { width: 100%; height: auto; filter: drop-shadow(0 30px 60px rgb(0 0 0 / .55)); -webkit-mask-image: linear-gradient(to bottom, #000 82%, transparent 100%); mask-image: linear-gradient(to bottom, #000 82%, transparent 100%); }
  .hero-first { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; object-position: bottom; -webkit-mask-image: linear-gradient(to bottom, #000 78%, transparent 99%); mask-image: linear-gradient(to bottom, #000 78%, transparent 99%); }
  .hero-frames { position: absolute; inset: 0; width: 100%; height: 100%; -webkit-mask-image: linear-gradient(to bottom, #000 78%, transparent 99%); mask-image: linear-gradient(to bottom, #000 78%, transparent 99%); }

  .hero-cards { list-style: none; padding: 0; position: absolute; inset: 0; pointer-events: none; perspective: 900px; }
  .hcard { position: absolute; left: 0; top: 0; width: clamp(120px, 31%, 210px); pointer-events: auto; will-change: transform; }
  .hcard-inner {
    display: grid; gap: .35rem; padding: .7rem .8rem .75rem; border-radius: 14px; color: inherit; text-decoration: none;
    background: rgb(22 20 18 / .9); border: 1px solid rgb(242 236 228 / .12);
    box-shadow: 0 18px 40px -18px rgb(0 0 0 / .8);
    transition: border-color .4s var(--ease-out), box-shadow .4s var(--ease-out);
  }
  .hcard-label { font-size: .62rem; text-transform: uppercase; letter-spacing: .12em; color: var(--champagne); }
  .hcard-title { font-size: .8rem; line-height: 1.3; color: var(--bone); }
  .hcard-thumb { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; object-position: top; border-radius: 8px; }
  .hcard-inner:hover, .hcard-inner:focus-visible { border-color: rgb(94 230 200 / .7); box-shadow: 0 18px 40px -18px rgb(0 0 0 / .8), 0 0 30px -2px rgb(94 230 200 / .7); }
  .hcard-state { display: inline-flex; align-items: center; gap: .4rem; font-family: var(--font-mono); font-size: .62rem; color: var(--smoke); }
  .hcard-state i { width: 7px; height: 7px; border-radius: 50%; background: var(--smoke); opacity: .6; flex: none; transition: background .3s; }
  .hcard-state .s-done { display: none; color: var(--mint); }
  .hcard.is-done .hcard-state .s-wait { display: none; }
  .hcard.is-done .hcard-state .s-done { display: inline; }
  .hcard.is-done .hcard-state i { background: var(--mint); opacity: 1; box-shadow: 0 0 10px var(--mint); }
  .hcard.is-done .hcard-inner { border-color: rgb(94 230 200 / .25); box-shadow: 0 18px 40px -18px rgb(0 0 0 / .8), 0 0 24px -4px rgb(94 230 200 / .45), 0 0 60px -20px rgb(94 230 200 / .5); }
  .tap { position: absolute; left: 50%; top: 50%; width: 54px; height: 54px; margin: -27px 0 0 -27px; border-radius: 50%; border: 2px solid var(--mint); background: radial-gradient(circle, rgb(94 230 200 / .35), transparent 70%); box-shadow: 0 0 12px var(--mint), 0 0 28px rgb(94 230 200 / .6), inset 0 0 10px rgb(94 230 200 / .6); opacity: 0; transform: scale(.4); pointer-events: none; z-index: 3; }
  .tap2 { border-color: var(--champagne); box-shadow: 0 0 12px var(--champagne), 0 0 26px rgb(200 169 126 / .5); background: none; }

  /* Neon beams from Tin's hand to each card */
  .hero-beams { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; z-index: 2; pointer-events: none; }
  .beam { fill: none; stroke: url(#beamGrad); stroke-width: 2.4; stroke-linecap: round; filter: url(#neon); opacity: 0; transition: stroke-width .25s; }
  .beam.is-hot { stroke-width: 3.6; }
  .touch { fill: #eafff9; filter: url(#neon); opacity: 0; }
  .touch-halo { fill: none; stroke: var(--mint); stroke-width: 2; filter: url(#neon); opacity: 0; }
  .trail { fill: none; stroke: url(#beamGrad); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; filter: url(#neon); opacity: 0; }

  /* Neon frame that circles a card once it's been tapped */
  @property --ang { syntax: '<angle>'; initial-value: 0deg; inherits: false; }
  .hcard-inner { position: relative; }
  .hcard-inner::before { content: ''; position: absolute; inset: -2px; border-radius: inherit; padding: 2px; background: conic-gradient(from var(--ang), transparent 0 55%, var(--mint) 70%, #eafff9 75%, var(--champagne) 85%, transparent 95%); -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0); opacity: 1; animation: neonspin 3.2s linear infinite; pointer-events: none; }
  @keyframes neonspin { to { --ang: 360deg; } }

  /* End-of-sequence chat bubbles */
  .chat { position: absolute; inset: 0; z-index: 4; pointer-events: none; }
  .bub { position: absolute; display: inline-flex; align-items: center; gap: .5rem; padding: .55rem .9rem; border-radius: 18px; font-size: .85rem; white-space: nowrap; }
  .b-client { left: 0; top: 15%; background: #fbf8f3; color: var(--espresso); border-bottom-left-radius: 4px; box-shadow: 0 10px 30px -10px #000; }
  .b-client .ava { width: 1.6rem; height: 1.6rem; display: grid; place-items: center; border-radius: 50%; background: var(--linen-2); font-size: .8rem; }
  .b-tin { right: 0; top: 26%; background: var(--mint); color: var(--onyx); font-weight: 600; border-bottom-right-radius: 4px; box-shadow: 0 0 22px rgb(94 230 200 / .7); }
  .js .bub { opacity: 0; }
  @media (max-width: 639px) { .b-client { left: 0; top: -4%; font-size: .74rem; } .b-tin { right: 0; top: 6%; font-size: .74rem; } }

  .hero-facts { list-style: none; display: grid; grid-template-columns: repeat(2, 1fr); gap: .75rem 1.5rem; margin-top: var(--space-l); padding-top: var(--space-m); border-top: 1px solid var(--line-dark); position: relative; z-index: 3; }
  .hero-facts li { display: grid; gap: .1rem; }
  .hero-facts strong { font-family: var(--font-display); font-weight: 400; font-size: var(--step-2); color: var(--bone); line-height: 1; }
  .hero-facts span { font-size: .8rem; color: var(--smoke); }

  /* Mobile: the orbit tightens up, and the mockups stay visible */
  @media (max-width: 639px) {
    .hcard { width: 36%; }
    .hcard-inner { padding: .4rem .45rem .5rem; gap: .25rem; border-radius: 10px; }
    .hcard-thumb { border-radius: 6px; }
    .hcard-label { font-size: .54rem; }
    .hcard-title { font-size: .66rem; }
    .hcard-state { font-size: .54rem; }
    .hero-stage { aspect-ratio: 1 / 1.12; }
    .hero-me { width: 72%; }
  }
  @media (min-width: 768px) {
    .hero-facts { grid-template-columns: repeat(4, 1fr); }
  }
  @media (min-width: 1024px) {
    .hero-grid { grid-template-columns: 1.05fr 1fr; gap: var(--space-xl); }
    .hero-stage { max-width: none; aspect-ratio: 1 / 1.02; max-height: 74svh; }
    .hero-pin { padding-top: 6rem; justify-content: center; }
    .hero-title { font-size: clamp(3rem, 0.6rem + 4.6vw, 6.2rem); }
  }
</style>

<script>
  import { gsap, ScrollTrigger, reducedMotion } from '../scripts/core';

  const hero = document.querySelector<HTMLElement>('.hero')!;
  const pin = hero.querySelector<HTMLElement>('.hero-pin')!;
  const cards = [...hero.querySelectorAll<HTMLElement>('.hcard')];
  const lines = hero.querySelectorAll<HTMLElement>('.hero-line');
  const ins = hero.querySelectorAll<HTMLElement>('.hero-in:not(.lead)');
  const me = hero.querySelector<HTMLElement>('.hero-me')!;
  const reduce = reducedMotion();

  // ---------- Background network: champagne nodes with mint pulses ----------
  function network() {
    const cv = hero.querySelector<HTMLCanvasElement>('.hero-net');
    if (!cv) return;
    const ctx = cv.getContext('2d')!;
    let w = 0, h = 0, dpr = Math.min(window.devicePixelRatio || 1, 1.25), odd = false;
    type P = { x: number; y: number; vx: number; vy: number };
    let pts: P[] = [];
    const resize = () => {
      const r = cv.getBoundingClientRect(); w = r.width; h = r.height;
      cv.width = w * dpr; cv.height = h * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const n = Math.round(Math.min(46, (w * h) / 9000));
      pts = Array.from({ length: n }, () => ({ x: Math.random() * w, y: Math.random() * h, vx: (Math.random() - .5) * .18, vy: (Math.random() - .5) * .18 }));
    };
    resize();
    let pulse = 0, visible = true, raf = 0;
    const draw = () => {
      odd = !odd;
      if (odd && !reduce) { if (visible) raf = requestAnimationFrame(draw); return; }
      ctx.clearRect(0, 0, w, h);
      pulse += 0.012;
      for (const p of pts) {
        if (!reduce) { p.x += p.vx * 2; p.y += p.vy * 2; if (p.x < 0 || p.x > w) p.vx *= -1; if (p.y < 0 || p.y > h) p.vy *= -1; }
      }
      for (let i = 0; i < pts.length; i++) for (let j = i + 1; j < pts.length; j++) {
        const a = pts[i], b = pts[j], d = Math.hypot(a.x - b.x, a.y - b.y);
        if (d < 120) {
          ctx.strokeStyle = `rgba(200,169,126,${(1 - d / 120) * .22})`; ctx.lineWidth = 1;
          ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
          if ((i + j) % 9 === 0) { // travelling mint pulse
            const t = (pulse * 2 + i * .13) % 1;
            ctx.fillStyle = `rgba(94,230,200,${(1 - d / 120) * .9})`;
            ctx.beginPath(); ctx.arc(a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t, 1.6, 0, 7); ctx.fill();
          }
        }
      }
      for (const p of pts) { ctx.fillStyle = 'rgba(200,169,126,.55)'; ctx.beginPath(); ctx.arc(p.x, p.y, 1.4, 0, 7); ctx.fill(); }
      if (visible && !reduce) raf = requestAnimationFrame(draw);
    };
    draw();
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; cancelAnimationFrame(raf); if (visible && !reduce) raf = requestAnimationFrame(draw); }).observe(cv);
    window.addEventListener('resize', () => { resize(); if (reduce) draw(); });
  }

  // ---------- Optional frame sequence of Tin (set hero.frames in site.yaml) ----------
  function frameSeq(): ((p: number) => void) | null {
    const cfg = hero.dataset.frames ? JSON.parse(hero.dataset.frames) : null;
    const cv = hero.querySelector<HTMLCanvasElement>('.hero-frames');
    if (!cfg || !cv || reduce) return null; // reduced motion keeps the still photo
    const ctx = cv.getContext('2d')!;
    const count: number = cfg.count;
    const first = hero.querySelector<HTMLImageElement>('.hero-first');
    const folder = cfg.folder + (matchMedia('(max-width: 639px)').matches ? 'm/' : '');
    const src = (i: number) => folder + cfg.pattern.replace('{n}', String(i + 1).padStart(cfg.digits || 3, '0'));
    const imgs: (HTMLImageElement | undefined)[] = new Array(count);
    const ready: boolean[] = new Array(count).fill(false);
    let want = 0, shown = -1;

    // Always show the loaded frame closest to where the visitor has scrolled.
    const draw = () => {
      let j = -1;
      for (let d = 0; d < count && j < 0; d++) {
        if (ready[want - d]) j = want - d;
        else if (ready[want + d]) j = want + d;
      }
      if (j < 0 || j === shown || !cv.width) return;
      shown = j;
      const im = imgs[j]!;
      const s = Math.min(cv.width / im.naturalWidth, cv.height / im.naturalHeight);
      const dw = im.naturalWidth * s, dh = im.naturalHeight * s;
      ctx.clearRect(0, 0, cv.width, cv.height);
      ctx.drawImage(im, (cv.width - dw) / 2, cv.height - dh, dw, dh);
      if (first) first.style.opacity = '0';
    };
    // Only resize the canvas when its size really changes: resizing wipes it and is slow.
    const size = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const w = Math.round(cv.clientWidth * dpr), h = Math.round(cv.clientHeight * dpr);
      if (w !== cv.width || h !== cv.height) { cv.width = w; cv.height = h; shown = -1; draw(); }
    };
    size();
    new ResizeObserver(size).observe(cv);

    const markReady = (i: number, im: HTMLImageElement) => {
      imgs[i] = im;
      // Decode first, so drawing the frame later doesn't stall the scroll.
      const done = () => { if (im.naturalWidth) { ready[i] = true; draw(); } };
      im.decode().then(done, done);
    };
    // Load evenly spaced frames first, so the whole motion plays early and gets smoother
    // as the rest arrive. Then fill in the frames nearest to the visitor.
    const pending = new Map<number, number>();
    [8, 4, 2, 1].forEach((step) => { for (let i = 0; i < count; i += step) if (i && !pending.has(i)) pending.set(i, step); });
    const next = () => {
      let best = -1, bestStep = 0, bestDist = 0;
      pending.forEach((step, i) => {
        const dist = Math.abs(i - want);
        if (best < 0 || step > bestStep || (step === bestStep && dist < bestDist)) { best = i; bestStep = step; bestDist = dist; }
      });
      if (best < 0) return;
      pending.delete(best);
      const im = new Image();
      im.onload = () => { markReady(best, im); next(); };
      im.onerror = () => next();
      im.src = src(best);
    };
    const start = () => { for (let k = 0; k < 6; k++) next(); };
    if (first && first.complete && first.naturalWidth) { markReady(0, first); start(); }
    else if (first) {
      first.addEventListener('load', () => { markReady(0, first); start(); }, { once: true });
      first.addEventListener('error', start, { once: true });
    } else start();

    return (p: number) => {
      want = Math.min(count - 1, Math.max(0, Math.round(p * (count - 1))));
      draw();
    };
  }

  network();
  const drawFrame = frameSeq();

  // ---------- Orbit: the cards circle Tin and follow her hand, joined to her fingertip by neon lines ----------
  // All timing comes from the clip. Re-measure these two tables if the clip ever changes.
  const stage = hero.querySelector<HTMLElement>('.hero-stage')!;
  const beams = [...hero.querySelectorAll<SVGPathElement>('.beam')];
  const beamLayer = hero.querySelector<SVGSVGElement>('.hero-beams')!;
  const touchDot = hero.querySelector<SVGCircleElement>('.touch')!;
  const touchHalo = hero.querySelector<SVGCircleElement>('.touch-halo')!;
  const trail = hero.querySelector<SVGPathElement>('.trail')!;
  const FRAME_RATIO = 1060 / 1280;
  const LAST_FRAME = 58; // frames - 1
  // Fingertip per video frame: [frame, x, y], as shares of the video picture
  const TIP: number[][] = [
    [1, .62, .86], [13, .62, .86], [14, .605, .555], [15, .43, .445], [16, .32, .42], [17, .263, .39], [18, .26, .41],
    [19, .28, .43], [20, .36, .445], [21, .41, .42], [22, .505, .40], [23, .574, .42], [24, .684, .42], [25, .758, .43],
    [27, .77, .43], [28, .747, .43], [29, .674, .42], [30, .547, .41], [31, .50, .40], [32, .40, .41], [33, .30, .42],
    [34, .285, .44], [35, .295, .44], [36, .353, .43], [37, .453, .41], [38, .51, .40], [39, .63, .43], [40, .705, .44],
    [41, .71, .45], [42, .69, .43], [43, .71, .43], [44, .763, .52], [45, .81, .67], [46, .83, .76], [47, .75, .9],
    [50, .62, .86], [59, .62, .86],
  ];
  // The moments she touches: left, right, left, right. `card` is the one that reaches her finger.
  const f = (n: number) => (n - 1) / LAST_FRAME;
  const TOUCHES = [
    { p: f(18), card: 0, side: 'left' },
    { p: f(26), card: 1, side: 'right' },
    { p: f(34), card: 2, side: 'left' },
    { p: f(41), card: 0, side: 'right' },
  ];
  // Orbit angle over the clip: holds on each touch and swings between them, as if she swipes the ring around.
  const ROT: number[][] = [[0, 150], [f(14), 150], [f(18), 180], [f(19), 180], [f(26), 240], [f(27), 240], [f(34), 300], [f(35), 300], [f(41), 360], [f(43), 360], [f(52), 390], [1, 390]];

  const lerpTable = (t: number[][], x: number, col: number) => {
    for (let i = 1; i < t.length; i++) if (x <= t[i][0]) { const a = t[i - 1], b = t[i]; return a[col] + (b[col] - a[col]) * ((x - a[0]) / (b[0] - a[0] || 1)); }
    return t[t.length - 1][col];
  };
  const smooth = (x: number) => x * x * (3 - 2 * x);
  function rotAt(p: number) {
    for (let i = 1; i < ROT.length; i++) if (p <= ROT[i][0]) { const a = ROT[i - 1], b = ROT[i]; return a[1] + (b[1] - a[1]) * smooth((p - a[0]) / (b[0] - a[0] || 1)); }
    return ROT[ROT.length - 1][1];
  }
  // Sizes are read once and saved until the layout changes; reading them on every scroll step causes lag.
  let sizes: { sw: number; sh: number; mw: number; mh: number; cw: number; ch: number } | null = null;
  const measure = () => (sizes ??= { sw: stage.offsetWidth, sh: stage.offsetHeight, mw: me.offsetWidth, mh: me.offsetHeight, cw: cards[0].offsetWidth, ch: cards[0].offsetHeight });
  function picture() { // where the video picture sits inside the stage
    const { sw, sh, mw, mh } = measure();
    const w = Math.min(mw, mh * FRAME_RATIO), h = w / FRAME_RATIO;
    return { left: (sw - w) / 2, top: sh - h, w, h };
  }
  function tipAt(p: number) {
    const fr = 1 + p * LAST_FRAME, pic = picture();
    return { x: pic.left + pic.w * lerpTable(TIP, fr, 1), y: pic.top + pic.h * lerpTable(TIP, fr, 2) };
  }

  let lastP = 0;
  let hovered = -1;
  let beamBase = reduce ? .26 : 0;
  let cardsIn = reduce ? 1 : 0; // eases to 1 during the entrance
  function place(p: number) {
    lastP = p;
    const { sw, sh, cw, ch } = measure(), pic = picture();
    // the ring is sized so a card's inner edge meets her fingertip at the far left and far right
    const gap = 4;
    const leftC = Math.max(pic.left + pic.w * .27 - gap - cw / 2, cw / 2 - sw * .03);
    const rightC = Math.min(pic.left + pic.w * .735 + gap + cw / 2, sw * 1.03 - cw / 2);
    const cx = (leftC + rightC) / 2, rx = (rightC - leftC) / 2;
    const cy = pic.top + pic.h * .43, ry = Math.min(sh * .3, (sh - cy - ch * .5) / Math.sin(Math.PI / 6) * .8);
    const rot = rotAt(p), tip = tipAt(p);
    const handUp = p > f(14) && p < f(47);
    const spin = (rotAt(Math.min(1, p + .012)) - rotAt(Math.max(0, p - .012))) / .024 / 12; // how fast the ring is swinging
    // Final pose: the cards sweep away so the chat and her smile have the stage
    const hide = cardsIn * (1 - smooth(Math.max(0, Math.min(1, (p - f(46)) / (f(50) - f(46))))));
    cards.forEach((c, i) => {
      const a = ((rot + i * 120) * Math.PI) / 180, sin = Math.sin(a), cos = Math.cos(a);
      // the path is a ribbon, not a flat ellipse: it dips and rises, and the ring swells while she swipes
      const swell = 1 + Math.min(.16, Math.abs(spin) * .004);
      let ccx = cx + rx * swell * cos;
      let ccy = cy + ry * swell * sin + Math.sin(a * 2 + rot * .017) * sh * .045;
      // magnet: the card she is reaching for is pulled onto her fingertip, then released with the swipe
      for (const t of TOUCHES) {
        if (t.card !== i) continue;
        const pull = p < t.p ? smooth(Math.max(0, 1 - (t.p - p) / .075)) : smooth(Math.max(0, 1 - (p - t.p) / .055));
        if (pull > 0) {
          const dir = t.side === 'left' ? -1 : 1;
          const tx = Math.min(sw * 1.03 - cw / 2, Math.max(cw / 2 - sw * .03, tip.x + dir * (gap + cw / 2)));
          ccx += (tx - ccx) * pull; ccy += (tip.y - ccy) * pull;
        }
      }
      const x = ccx - cw / 2, y = ccy - ch / 2;
      const near = Math.min(1, (sin + 1) * 1.25); // 0 at the back of the ring, 1 from the sides forward
      // cards lean into the swipe and bank as they travel round
      const lean = Math.max(-1, Math.min(1, spin * .05));
      gsap.set(c, { x, y, scale: .78 + .22 * near, zIndex: sin < -.2 ? 0 : 3, transformOrigin: '50% 50%', rotationY: cos * -14 + lean * 12, rotationZ: lean * (sin >= 0 ? -7 : 7), rotationX: sin * 5, autoAlpha: reduce ? 1 : hide });
      const inner = c.querySelector<HTMLElement>('.hcard-inner')!;
      inner.style.opacity = String(.5 + .5 * near);
      // neon line: fingertip to card, brightest while that card is at her finger or under the cursor
      const beam = beams[i];
      if (beam) {
        const mx = (tip.x + ccx) / 2, my = (tip.y + ccy) / 2 + Math.abs(ccx - tip.x) * .18;
        beam.setAttribute('d', `M ${tip.x} ${tip.y} Q ${mx} ${my} ${ccx} ${ccy}`);
        const touching = TOUCHES.some((t) => t.card === i && Math.abs(p - t.p) < .035);
        const hot = touching || hovered === i;
        beam.classList.toggle('is-hot', hot);
        beam.style.opacity = String((hot ? 1 : beamBase * (.6 + .4 * near)) * (reduce ? 1 : hide));
      }
      c.classList.toggle('is-done', reduce || p >= (TOUCHES.find((t) => t.card === i)?.p ?? 1));
    });
    touchDot.setAttribute('cx', String(tip.x)); touchDot.setAttribute('cy', String(tip.y));
    touchDot.style.opacity = handUp ? '1' : '0';
    // Neon on her fingertip, with a trail that follows the swipe (scroll back and it retraces)
    const tp = TOUCHES.some((t) => Math.abs(p - t.p) < .03);
    touchHalo.setAttribute('cx', String(tip.x)); touchHalo.setAttribute('cy', String(tip.y));
    touchHalo.style.opacity = handUp ? (tp ? '1' : '.55') : '0';
    touchHalo.setAttribute('r', tp ? '22' : '14');
    if (handUp) {
      const pts: string[] = [];
      for (let k = 5; k >= 0; k--) { const q = tipAt(Math.max(f(14), p - k * .006)); pts.push(`${k === 5 ? 'M' : 'L'} ${q.x.toFixed(1)} ${q.y.toFixed(1)}`); }
      trail.setAttribute('d', pts.join(' '));
      trail.style.opacity = '.9';
    } else trail.style.opacity = '0';
  }
  function ring(i: number, side?: string) {
    const c = cards[i]; if (!c) return;
    const taps = c.querySelectorAll<HTMLElement>('.tap');
    if (side) gsap.set(taps, { left: side === 'left' ? '100%' : '0%' }); else gsap.set(taps, { left: '50%' });
    gsap.fromTo(taps[0], { opacity: 1, scale: .4 }, { opacity: 0, scale: 2.2, duration: .6, ease: 'power2.out', overwrite: true });
    gsap.fromTo(taps[1], { opacity: .9, scale: .6 }, { opacity: 0, scale: 2.8, duration: .75, ease: 'power2.out', overwrite: true });
  }
  // Hover, focus or tap a card: its neon line lights up and rings fire
  cards.forEach((c, i) => {
    const on = () => { hovered = i; place(lastP); if (!reduce) ring(i); };
    const off = () => { hovered = -1; place(lastP); };
    c.addEventListener('pointerenter', on); c.addEventListener('pointerleave', off);
    c.addEventListener('focusin', on); c.addEventListener('focusout', off);
  });
  place(0);
  const replace = () => { sizes = null; place(lastP); };
  window.addEventListener('resize', replace);
  ScrollTrigger.addEventListener('refresh', replace);
  window.addEventListener('load', replace);

  if (reduce) {
    hero.querySelectorAll<HTMLElement>('.bub').forEach((b) => (b.style.opacity = '1'));
  } else {
    // Entrance after the page intro
    gsap.set(lines, { yPercent: 110 });
    gsap.set(ins, { opacity: 0, y: 20 });
    const lit = { v: 0 };
    const enter = () => {
      const tl = gsap.timeline({ defaults: { ease: 'expo.out' } });
      tl.to(lines, { yPercent: 0, duration: 1.1, stagger: .12 })
        .to(ins, { opacity: 1, y: 0, duration: .9, stagger: .06 }, '-=.7')
        .to(lit, { v: 1, duration: 1.1, onUpdate: () => { cardsIn = lit.v; beamBase = lit.v * .26; place(lastP); }, onComplete: replace }, '-=.9');
      // gentle idle float
      cards.forEach((c, i) => gsap.to(c.querySelector('.hcard-inner'), { y: i % 2 ? 5 : -5, duration: 2.6 + i * .3, ease: 'sine.inOut', yoyo: true, repeat: -1 }));
    };
    let entered = false;
    const go = () => { if (!entered) { entered = true; enter(); } };
    if (document.documentElement.classList.contains('intro-done') || !document.querySelector('.intro')) go();
    else { window.addEventListener('intro:almost', go, { once: true }); window.addEventListener('intro:done', go, { once: true }); }

    // Scroll story: pin, play the clip, swing the ring with her hand, finish on Tin
    const mm = gsap.matchMedia();
    mm.add({ desktop: '(min-width: 1024px)', mobile: '(max-width: 1023px)' }, (ctx) => {
      const isDesk = ctx.conditions!.desktop;
      const tick = () => { const p = tl.progress(); drawFrame?.(p); place(p); };
      const tl = gsap.timeline({
        defaults: { ease: 'none' },
        onUpdate: tick,
        scrollTrigger: isDesk
          ? { trigger: hero, start: 'top top', end: '+=170%', pin: pin, scrub: .6, anticipatePin: 1 }
          : { trigger: stage, start: 'center center', end: '+=150%', pin: stage, scrub: .6, anticipatePin: 1 },
      });
      // Exactly 1 long, so every position below is a share of the clip.
      tl.to({ v: 0 }, { v: 1, duration: 1 }, 0);
      TOUCHES.forEach((t) => {
        const c = cards[t.card];
        if (!c) return;
        const inner = c.querySelector('.hcard-inner'), taps = c.querySelectorAll<HTMLElement>('.tap');
        tl.set(taps, { left: t.side === 'left' ? '100%' : '0%' }, t.p - .004)
          .fromTo(taps[0], { opacity: 0, scale: .4 }, { opacity: 1, scale: 1, duration: .016, ease: 'power2.out', immediateRender: false }, t.p)
          .to(inner, { scale: .94, duration: .014, ease: 'power2.in' }, t.p)
          .to(inner, { scale: 1, duration: .03, ease: 'back.out(2.2)' }, t.p + .014)
          .to(taps[0], { opacity: 0, scale: 2.2, duration: .04, ease: 'power2.out' }, t.p + .016)
          .fromTo(taps[1], { opacity: .9, scale: .6 }, { opacity: 0, scale: 2.8, duration: .05, ease: 'power2.out', immediateRender: false }, t.p + .01);
      });
      // Finale, as her arms cross again: chat pops up and Tin steps forward
      tl.fromTo('.b-client', { opacity: 0, y: 16, scale: .8 }, { opacity: 1, y: 0, scale: 1, duration: .045, ease: 'back.out(2)' }, f(50))
        .fromTo('.b-tin', { opacity: 0, y: 16, scale: .8 }, { opacity: 1, y: 0, scale: 1, duration: .045, ease: 'back.out(2)' }, f(53))
        .to(me, { scale: 1.04, transformOrigin: '50% 100%', duration: .08 }, .88)
        .to(hero.querySelector('.hero-glow'), { opacity: 1.4, scale: 1.1, duration: .08 }, .88);
      return () => {};
    });
  }
</script>
