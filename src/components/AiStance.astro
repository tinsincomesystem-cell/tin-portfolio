---
// "My take on AI" statement. Copy lives in src/content/stance.yaml.
import { stance, rich } from '../lib/content';
---
<section id="ai" class="stance s-dark section" aria-labelledby="stance-title">
  <div class="wrap stance-grid">
    <div class="stance-copy">
      <span class="eyebrow" data-reveal>{stance.eyebrow}</span>
      <h2 id="stance-title" class="h-1" data-reveal style="--d:.05" set:html={rich(stance.title)} />
      {stance.paragraphs.map((p: string, i: number) => (
        <p class="lead" data-reveal style={`--d:${.1 + i * .05}`}>{p}</p>
      ))}
    </div>
    <ul class="stance-list" role="list">
      {stance.points.map((pt: any, i: number) => (
        <li data-reveal style={`--d:${i * .08}`}>
          <div class="stance-point" tabindex="0">
            <h3>{pt.title}</h3>
            <p>{pt.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .stance-grid { display: grid; gap: var(--space-l); align-items: center; }
  .stance-copy { display: grid; gap: var(--space-m); }
  .stance-copy :global(em) { color: var(--champagne); }
  .stance-list { list-style: none; padding: 0; display: grid; gap: .85rem; }
  .stance-point { padding: 1.25rem 1.35rem; border-radius: 14px; background: rgb(22 20 18 / .78); border: 1px solid rgb(94 230 200 / .28); box-shadow: 0 0 26px -10px rgb(94 230 200 / .55); position: relative; cursor: default; transition: transform .45s var(--ease-out), box-shadow .45s var(--ease-out), border-color .3s; }
  .stance-point::before { content: ''; position: absolute; inset: -2px; border-radius: inherit; padding: 2px; background: conic-gradient(from var(--stance-ang), transparent 0 55%, var(--mint) 70%, #eafff9 75%, var(--champagne) 85%, transparent 95%); -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0); opacity: 0; transition: opacity .35s; pointer-events: none; animation: stancespin 3.2s linear infinite; }
  .stance-point:hover, .stance-point:focus-visible, .stance-point:active { transform: translateX(-10px) scale(1.04); border-color: rgb(94 230 200 / .7); box-shadow: 0 24px 50px -22px #000, 0 0 44px -6px rgb(94 230 200 / .75); }
  .stance-point:hover::before, .stance-point:focus-visible::before, .stance-point:active::before { opacity: 1; }
  @property --stance-ang { syntax: '<angle>'; initial-value: 0deg; inherits: false; }
  @keyframes stancespin { to { --stance-ang: 360deg; } }
  @media (prefers-reduced-motion: reduce) { .stance-point { transition: none; } .stance-point:hover, .stance-point:focus-visible, .stance-point:active { transform: none; } .stance-point::before { animation: none; } }
  .stance-point h3 { font-family: var(--font-display); font-weight: 400; font-size: var(--step-2); color: var(--bone); line-height: 1.15; }
  .stance-point p { margin-top: .35rem; color: var(--smoke); }
  @media (min-width: 1024px) { .stance-grid { grid-template-columns: 1.15fr 1fr; gap: var(--space-xl); } }
</style>
