---
import Icon from './Icon.astro';
import { pricing as p, faq, site, rich, showTodos } from '../lib/content';
const modes = ['monthly', 'project'] as const;
const firstOf = (m: string) => p.categories.find((c: any) => c.mode === m)?.id;
---
<section id="pricing" class="pricing s-light section" aria-labelledby="pricing-title">
  <div class="wrap">
    <div class="section-head center">
      <span class="eyebrow" data-reveal>{p.eyebrow}</span>
      <h2 id="pricing-title" class="h-1" data-reveal style="--d:.05" set:html={rich(p.title)} />
      <p class="lead" data-reveal style="--d:.1">{p.intro}</p>
    </div>

    <div class="controls" data-reveal>
      <div class="mode" role="group" aria-label="Billing type">
        {modes.map((m, i) => <button type="button" class="mode-btn" data-mode={m} aria-pressed={i === 0 ? 'true' : 'false'}>{p.toggle[m]}</button>)}
        <span class="mode-pill" aria-hidden="true"></span>
      </div>
      {modes.map((m, mi) => (
        <div class="tabs" role="tablist" aria-label={`${p.toggle[m]} categories`} data-tabs={m} hidden={mi !== 0}>
          {p.categories.filter((c: any) => c.mode === m).map((c: any) => (
            <button type="button" role="tab" id={`tab-${c.id}`} aria-controls={`panel-${c.id}`} aria-selected={c.id === firstOf(m) ? 'true' : 'false'} tabindex={c.id === firstOf(m) ? 0 : -1} data-tab={c.id}>{c.label}</button>
          ))}
        </div>
      ))}
    </div>

    {p.categories.map((c: any) => (
      <div class="plans" role="tabpanel" id={`panel-${c.id}`} aria-labelledby={`tab-${c.id}`} data-panel={c.id} data-mode={c.mode} hidden={c.id !== firstOf('monthly')}>
        {showTodos && c.todo && <p class="plans-todo"><span class="todo">TODO · {c.todo}</span></p>}
        <div class={`plan-grid n${c.plans.length}`}>
          {c.plans.map((pl: any) => (
            <article class={`plan ${pl.popular ? 'is-popular neon-frame' : ''}`}>
              {pl.popular && <span class="pop mono">Most popular</span>}
              <header>
                <h3 class="plan-name">{pl.name}</h3>
                {pl.note && <p class="plan-note mono">{pl.note}</p>}
                <p class="plan-price"><span class="amt">{pl.price}</span><span class="per">{pl.period}</span></p>
              </header>
              <ul role="list">{pl.features.map((f: string) => <li><Icon name="check" size={16} />{f}</li>)}</ul>
              {pl.footer && <p class="plan-foot">{pl.footer}</p>}
              <a class={`btn ${pl.popular ? '' : 'btn-ghost'}`} href={site.bookingUrl} target="_blank" rel="noopener" data-magnetic=".2">Start with a call <span class="arrow" aria-hidden="true">→</span></a>
            </article>
          ))}
        </div>
      </div>
    ))}

    <div class="hourly" data-reveal>
      <div><strong>{p.hourly.title}</strong><p class="muted">{p.hourly.text}</p></div>
      <p class="hourly-price"><span>{p.hourly.price}</span><small>{p.hourly.period}</small></p>
    </div>
    <p class="currency muted mono">{p.currencyNote}</p>

    <div id="faq" class="faq">
      <div class="faq-head">
        <span class="eyebrow">{faq.eyebrow}</span>
        <h2 class="h-2" set:html={rich(faq.title)} />
        {showTodos && faq.todo && <span class="todo">TODO · {faq.todo}</span>}
      </div>
      <div class="faq-list">
        {faq.items.map((f: any) => (
          <details class="qa">
            <summary><span>{f.q}</span><i aria-hidden="true"></i></summary>
            <div class="qa-body"><p>{f.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .controls { display: grid; justify-items: center; gap: 1.25rem; margin-bottom: 2.5rem; }
  .mode { position: relative; display: inline-grid; grid-template-columns: 1fr 1fr; padding: .3rem; border-radius: 999px; background: var(--linen-2); border: 1px solid var(--line); }
  .mode-btn { position: relative; z-index: 1; min-height: 2.75rem; padding: .5rem 1.2rem; border-radius: 999px; font-weight: 600; font-size: .92rem; color: var(--umber); transition: color .35s; white-space: nowrap; }
  .mode-btn[aria-pressed='true'] { color: var(--linen); }
  .mode-pill { position: absolute; top: .3rem; bottom: .3rem; left: .3rem; width: calc(50% - .3rem); border-radius: 999px; background: var(--espresso); transition: transform .5s var(--ease-out); }
  .mode.is-project .mode-pill { transform: translateX(100%); }
  .tabs { display: flex; flex-wrap: wrap; justify-content: center; gap: .4rem; }
  .tabs[hidden] { display: none; }
  .tabs [role='tab'] { min-height: 2.6rem; padding: .45rem 1rem; border-radius: 999px; border: 1px solid var(--line); font-size: .9rem; color: var(--umber); transition: .25s; }
  .tabs [role='tab']:hover { border-color: var(--espresso); color: var(--espresso); }
  .tabs [role='tab'][aria-selected='true'] { border-color: var(--terracotta-ink); color: var(--terracotta-ink); background: rgb(198 93 59 / .07); }

  .plans[hidden] { display: none; }
  .plans:not([hidden]) { animation: fadeup .55s var(--ease-out); }
  @keyframes fadeup { from { opacity: 0; transform: translateY(16px); } }
  .plans-todo { text-align: center; margin-bottom: 1rem; }
  .plan-grid { display: grid; gap: 1rem; align-items: stretch; }
  .plan { position: relative; display: flex; flex-direction: column; gap: 1.1rem; padding: clamp(1.4rem, 3vw, 2rem); border-radius: var(--radius-l); background: var(--card); border: 1px solid var(--line); }
  .plan.is-popular { background: var(--espresso); color: var(--linen); border-color: var(--espresso); --muted: #cbbfb2; --accent: var(--champagne); box-shadow: 0 40px 80px -50px rgb(42 31 26 / .7); }
  .plan.is-popular .btn { --btn-bg: var(--champagne); --btn-fg: var(--onyx); }
  .pop { position: absolute; top: -0.8rem; left: 50%; transform: translateX(-50%); background: var(--terracotta-ink); color: #fff; padding: .35rem .8rem; border-radius: 999px; font-size: .68rem; letter-spacing: .1em; text-transform: uppercase; white-space: nowrap; }
  .plan-name { font-family: var(--font-display); font-size: var(--step-2); }
  .plan-note { font-size: .72rem; color: var(--accent); margin-top: .15rem; }
  .plan-price { display: flex; align-items: baseline; gap: .4rem; margin-top: .5rem; }
  .amt { font-family: var(--font-display); font-size: clamp(2.6rem, 5vw, 3.4rem); line-height: 1; }
  .per { color: var(--muted); font-size: .9rem; }
  .plan ul { list-style: none; padding: 0; display: grid; gap: .5rem; font-size: .93rem; }
  .plan li { display: flex; gap: .55rem; }
  .plan li :global(.icon) { flex: none; margin-top: .2rem; color: var(--accent); }
  .plan-foot { font-size: .82rem; color: var(--muted); border-top: 1px solid var(--line); padding-top: .9rem; margin-top: auto; }
  .plan .btn { width: 100%; }

  .hourly { margin-top: 2rem; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem; padding: 1.25rem 1.5rem; border-radius: var(--radius-m); border: 1px dashed var(--line); }
  .hourly-price span { font-family: var(--font-display); font-size: var(--step-3); }
  .hourly-price small { color: var(--muted); }
  .currency { text-align: center; font-size: .72rem; margin-top: 1rem; }

  .faq { margin-top: var(--space-2xl); display: grid; gap: 2rem; }
  .faq-head { display: grid; gap: .8rem; align-content: start; justify-items: start; }
  .faq-list { border-top: 1px solid var(--line); }
  .qa { border-bottom: 1px solid var(--line); }
  .qa summary { list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1.2rem 0; cursor: pointer; font-size: 1.08rem; font-weight: 500; }
  .qa summary::-webkit-details-marker { display: none; }
  .qa summary i { position: relative; flex: none; width: 1.9rem; height: 1.9rem; border-radius: 50%; border: 1px solid var(--line); }
  .qa summary i::before, .qa summary i::after { content: ''; position: absolute; left: 50%; top: 50%; width: 10px; height: 1.5px; background: currentColor; transform: translate(-50%, -50%); transition: transform .35s var(--ease-out); }
  .qa summary i::after { transform: translate(-50%, -50%) rotate(90deg); }
  .qa[open] summary i::after { transform: translate(-50%, -50%) rotate(0deg); }
  .qa-body { overflow: hidden; }
  .qa-body p { padding-bottom: 1.25rem; color: var(--muted); max-width: 68ch; }

  @media (min-width: 768px) {
    .plan-grid.n2 { grid-template-columns: repeat(2, minmax(0, 360px)); justify-content: center; }
    .plan-grid.n3 { grid-template-columns: repeat(3, 1fr); }
    .plan-grid.n1 { grid-template-columns: minmax(0, 420px); justify-content: center; }
    .plan.is-popular { transform: translateY(-.75rem); }
  }
  @media (max-width: 767px) { .plan-grid { max-width: 440px; margin-inline: auto; } .plan.is-popular { order: -1; } }
  @media (min-width: 1024px) { .faq { grid-template-columns: .8fr 1.2fr; gap: var(--space-xl); } }
</style>

<script>
  import { reducedMotion, ScrollTrigger } from '../scripts/core';
  const sec = document.getElementById('pricing')!;
  const modeWrap = sec.querySelector<HTMLElement>('.mode')!;
  const panels = [...sec.querySelectorAll<HTMLElement>('[data-panel]')];

  function selectTab(id: string, focus = false) {
    const tab = sec.querySelector<HTMLButtonElement>(`[data-tab="${id}"]`)!;
    tab.parentElement!.querySelectorAll<HTMLButtonElement>('[role="tab"]').forEach((t) => { const on = t === tab; t.setAttribute('aria-selected', String(on)); t.tabIndex = on ? 0 : -1; });
    panels.forEach((p) => (p.hidden = p.dataset.panel !== id));
    if (focus) tab.focus();
    ScrollTrigger.refresh();
  }
  sec.querySelectorAll<HTMLButtonElement>('.mode-btn').forEach((b) => b.addEventListener('click', () => {
    const m = b.dataset.mode!;
    sec.querySelectorAll('.mode-btn').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    modeWrap.classList.toggle('is-project', m === 'project');
    sec.querySelectorAll<HTMLElement>('[data-tabs]').forEach((t) => (t.hidden = t.dataset.tabs !== m));
    const active = sec.querySelector<HTMLButtonElement>(`[data-tabs="${m}"] [aria-selected="true"]`)!;
    selectTab(active.dataset.tab!);
  }));
  sec.querySelectorAll<HTMLElement>('[role="tablist"]').forEach((list) => {
    const tabs = [...list.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => selectTab(t.dataset.tab!));
      t.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!d) return; e.preventDefault();
        selectTab(tabs[(i + d + tabs.length) % tabs.length].dataset.tab!, true);
      });
    });
  });

  // Quiz "See the plan" button → open the right tab
  window.addEventListener('pricing:select', (e: Event) => {
    const tab = (e as CustomEvent).detail?.tab;
    const btn = tab && sec.querySelector<HTMLButtonElement>(`[data-tab="${tab}"]`);
    if (!btn) return;
    const mode = sec.querySelector<HTMLElement>(`[data-panel="${tab}"]`)!.dataset.mode!;
    sec.querySelector<HTMLButtonElement>(`.mode-btn[data-mode="${mode}"]`)!.click();
    selectTab(tab);
  });

  // Smooth FAQ accordion
  sec.querySelectorAll<HTMLDetailsElement>('.qa').forEach((d) => {
    const s = d.querySelector('summary')!, body = d.querySelector<HTMLElement>('.qa-body')!;
    s.addEventListener('click', (e) => {
      if (reducedMotion()) return;
      e.preventDefault();
      if (d.open) {
        const a = body.animate([{ height: body.offsetHeight + 'px' }, { height: '0px' }], { duration: 320, easing: 'cubic-bezier(.22,1,.36,1)' });
        a.onfinish = () => { d.open = false; ScrollTrigger.refresh(); };
      } else {
        d.open = true;
        body.animate([{ height: '0px' }, { height: body.offsetHeight + 'px' }], { duration: 380, easing: 'cubic-bezier(.22,1,.36,1)' }).onfinish = () => ScrollTrigger.refresh();
      }
    });
  });
</script>
