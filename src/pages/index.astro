---
// Homepage. Change the ORDER of sections by moving these lines.
// Change the CONTENT in src/content/*.yaml.
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import ScrollScene from '../components/ScrollScene.astro';
import AiStance from '../components/AiStance.astro';
import Services from '../components/Services.astro';
import IntroFilm from '../components/IntroFilm.astro';
import Funnels from '../components/Funnels.astro';
import VaMeter from '../components/VaMeter.astro';
import BrandStories from '../components/BrandStories.astro';
import Websites from '../components/Websites.astro';
import Automation from '../components/Automation.astro';
import Pricing from '../components/Pricing.astro';
import Process from '../components/Process.astro';
import Testimonials from '../components/Testimonials.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import Assistant from '../components/Assistant.astro';
---
<Base intro>
  <Nav />
  <main id="main">
    <Hero />
    <ScrollScene />
    <AiStance />
    <Services />
    <IntroFilm />
    <Funnels />
    <VaMeter />
    <BrandStories />
    <Websites />
    <Automation />
    <Pricing />
    <Process />
    <Testimonials />
    <About />
    <Contact />
  </main>
  <Footer />
  <Assistant />
</Base>
